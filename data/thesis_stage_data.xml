<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Langkah 1: Desain & Fondasi -->
        <record id="stage_step1_topic" model="thesis.stage">
            <field name="name">1.1 Eksplorasi Topik &amp; Masalah</field>
            <field name="sequence">10</field>
            <field name="step_category">step1</field>
            <field name="description">Merumuskan topik awal, kelayakan akses data, dan 2-3 alternatif pertanyaan penelitian.</field>
        </record>

        <record id="stage_step1_literature" model="thesis.stage">
            <field name="name">1.2 Tinjauan Pustaka &amp; Teori</field>
            <field name="sequence">20</field>
            <field name="step_category">step1</field>
            <field name="description">Membangun matriks literatur, klarifikasi konsep kunci, dan uji kompatibilitas kerangka teoretis.</field>
        </record>

        <record id="stage_step1_methodology" model="thesis.stage">
            <field name="name">1.3 Desain Metodologi Riset</field>
            <field name="sequence">30</field>
            <field name="step_category">step1</field>
            <field name="description">Menyelaraskan rumusan masalah, operasionalisasi variabel/kategori, dan protokol instrumen.</field>
        </record>

        <!-- Langkah 2: Analisis & Temuan -->
        <record id="stage_step2_collection" model="thesis.stage">
            <field name="name">2.1 Pengumpulan &amp; Validasi Data</field>
            <field name="sequence">40</field>
            <field name="step_category">step2</field>
            <field name="description">Pemeriksaan integritas korpus, transkrip wawancara, pembersihan dataset, dan kepatuhan etik.</field>
        </record>

        <record id="stage_step2_analysis" model="thesis.stage">
            <field name="name">2.2 Analisis &amp; Temuan Empiris</field>
            <field name="sequence">50</field>
            <field name="step_category">step2</field>
            <field name="description">Mengelompokkan temuan, pola data, rantai bukti empiris (Chain of Evidence), dan visualisasi.</field>
        </record>

        <!-- Langkah 3: Penulisan & Sintesis -->
        <record id="stage_step3_discussion" model="thesis.stage">
            <field name="name">3.1 Pembahasan &amp; Dialektika Teori</field>
            <field name="sequence">60</field>
            <field name="step_category">step3</field>
            <field name="description">Menghubungkan temuan dengan literatur terdahulu, implikasi teoretis, dan batasan riset.</field>
        </record>

        <record id="stage_step3_finalization" model="thesis.stage">
            <field name="name">3.2 Poles Naskah &amp; Pemeriksaan Kesiapan</field>
            <field name="sequence">70</field>
            <field name="step_category">step3</field>
            <field name="description">Peninjauan register akademik, keselarasan pendahuluan-pembahasan, dan daftar periksa kelengkapan sitasi.</field>
        </record>

        <!-- Sidang Akhir -->
        <record id="stage_defense_ready" model="thesis.stage">
            <field name="name">Siap Ujian Sidang / Munaqasyah</field>
            <field name="sequence">80</field>
            <field name="step_category">defense</field>
            <field name="fold">True</field>
            <field name="description">Naskah lengkap disetujui pembimbing beserta dokumen Pengungkapan Pemanfaatan AI resmi.</field>
        </record>
    </data>
</odoo>
