<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_thesis_project_kanban" model="ir.ui.view">
        <field name="name">thesis.project.kanban</field>
        <field name="model">thesis.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="student_id"/>
                <field name="degree_level"/>
                <field name="stage_id"/>
                <field name="execution_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title text-primary"><field name="name"/></strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body small text-muted">
                            <div><i class="fa fa-user me-1"/> Peneliti: <field name="student_id"/></div>
                            <div><i class="fa fa-graduation-cap me-1"/> Jenjang: <field name="degree_level"/></div>
                        </div>
                        <footer class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="badge rounded-pill bg-light text-dark border">
                                <i class="fa fa-robot me-1 text-info"/> <field name="execution_count"/> Sesi AI
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_thesis_project_tree" model="ir.ui.view">
        <field name="name">thesis.project.tree</field>
        <field name="model">thesis.project</field>
        <field name="arch" type="xml">
            <list string="Daftar Proyek Tugas Akhir">
                <field name="name"/>
                <field name="student_id"/>
                <field name="degree_level"/>
                <field name="stage_id"/>
                <field name="execution_count" string="Sesi AI"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_thesis_project_form" model="ir.ui.view">
        <field name="name">thesis.project.form</field>
        <field name="model">thesis.project</field>
        <field name="arch" type="xml">
            <form string="Proyek Tugas Akhir">
                <header>
                    <button name="action_launch_prompt_wizard"
                            string="Jalankan Asisten AI Riset"
                            type="object"
                            class="oe_highlight"
                            icon="fa-magic"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_executions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-robot">
                            <field name="execution_count" widget="statinfo" string="Sesi AI"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Judul Tugas Akhir</span>
                        <h1>
                            <field name="name" placeholder="Masukkan Judul Skripsi / Tesis / Disertasi..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identitas Akademik">
                            <field name="student_id"/>
                            <field name="degree_level"/>
                        </group>
                        <group string="Tim Pembimbing">
                            <field name="advisor_ids" widget="many2many_tags" placeholder="Pilih Dosen Pembimbing..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fondasi &amp; Desain Riset">
                            <group>
                                <field name="research_topic" placeholder="Bidang minat atau topik awal..." widget="text"/>
                                <field name="research_questions" placeholder="Rumusan pertanyaan penelitian..." widget="text"/>
                                <field name="theoretical_framework" placeholder="Kerangka teoretis..." widget="text"/>
                                <field name="methodology_summary" placeholder="Ringkasan metodologi..." widget="text"/>
                            </group>
                        </page>
                        <page string="Rekam Jejak AI (Audit Trail)">
                            <field name="execution_ids">
                                <list string="Sesi AI">
                                    <field name="create_date" string="Waktu"/>
                                    <field name="prompt_code"/>
                                    <field name="name"/>
                                    <field name="is_cross_degree" string="Kesesuaian Jenjang" widget="badge" decoration-warning="is_cross_degree" decoration-success="not is_cross_degree"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_thesis_project" model="ir.actions.act_window">
        <field name="name">Proyek Tugas Akhir</field>
        <field name="res_model">thesis.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mulai daftarkan proyek tugas akhir Anda.
            </p>
        </field>
    </record>
</odoo>
